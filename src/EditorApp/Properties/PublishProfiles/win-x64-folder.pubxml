<?xml version="1.0" encoding="utf-8"?>
<!--
  The same standalone Windows build, as a folder instead of one file.

    dotnet publish src\EditorApp -p:PublishProfile=win-x64-folder

  Use this one for sending the editor to anybody else. A single-file build is a small executable
  carrying a compressed payload that it unpacks and loads at startup, which is also an exact
  description of a dropper — heuristic scanners flag the shape, not anything the program does, and
  an unsigned binary has no reputation to argue with. The folder build packs nothing and compresses
  nothing, so there is far less for a scanner to object to.

  Zip the folder before uploading it anywhere. A bare .exe attracts scrutiny that the same bytes
  inside an archive do not.

  Keep the folder together: the executable needs the files beside it.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>

    <!-- The two properties this profile exists for. -->
    <PublishSingleFile>false</PublishSingleFile>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <PublishDir>..\..\publish\win-x64-folder\</PublishDir>
  </PropertyGroup>
</Project>
