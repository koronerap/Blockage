<?xml version="1.0" encoding="utf-8"?>
<!--
  A standalone Blockage for Apple Silicon.

    dotnet publish src\EditorApp -p:PublishProfile=osx-arm64

  This builds from Windows. The SDK downloads the macOS runtime pack, crossgen2 precompiles for
  arm64, and the single-file host is given an ad-hoc code signature — which matters, because Apple
  Silicon refuses to execute an unsigned binary at all.

  For an Intel Mac, change the RuntimeIdentifier to osx-x64.

  What cross-building cannot do is test itself. The result is a bare Mach-O executable, not a .app
  bundle, so it is launched from a terminal; and macOS may still hold it under quarantine if it
  arrives by download rather than by copy.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- The UI font is a content file; without this it is published beside the executable and the
         editor falls back to a system face the moment the binary is moved on its own. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Off, as on Windows: Silk.NET resolves native entry points and SharpGLTF serialises through
         reflection, and a trimmer sees neither. -->
    <PublishTrimmed>false</PublishTrimmed>

    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <PublishDir>..\..\publish\osx-arm64\</PublishDir>
  </PropertyGroup>
</Project>
