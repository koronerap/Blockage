<?xml version="1.0" encoding="utf-8"?>
<!--
  A standalone Blockage.exe: one file, no .NET installation required on the machine that runs it.

    dotnet publish src\EditorApp -p:PublishProfile=win-x64

  Kept in a profile rather than in the csproj so that a plain build stays framework-dependent and
  architecture-neutral — pinning a RuntimeIdentifier in the project makes every ordinary build and
  every `dotnet run` do the self-contained work as well.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- The runtime travels with the application. -->
    <SelfContained>true</SelfContained>

    <PublishSingleFile>true</PublishSingleFile>

    <!-- Not just the managed assemblies: the UI font is a content file, and without this it would
         be published beside the executable instead of inside it. The editor would still run, but it
         would fall back to a system font the moment the exe was moved on its own. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Precompiled, so the first frame does not wait on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Deliberately off. Silk.NET resolves native entry points and SharpGLTF serialises through
         reflection; a trimmer has no way to see either, and what it removes only fails at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Symbols go inside the executable. Without the second line the referenced projects still
         drop their .pdb beside it, and the output stops being one file. -->
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
