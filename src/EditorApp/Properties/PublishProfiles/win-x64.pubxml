<?xml version="1.0" encoding="utf-8"?>
<!--
  A standalone Blockage for Windows: five files, no .NET installation needed.

    dotnet publish src\EditorApp -p:PublishProfile=win-x64

    Blockage.exe          the application and the whole runtime
    cimgui.dll            ImGui
    glfw3.dll             windowing and input
    assets\fonts\         the UI font

  Two things are deliberately *not* bundled into the executable, and they are the difference between
  this and a one-file build.

  Native libraries. A one-file build unpacks them to a temporary directory and loads them from there
  at startup — which is also an exact description of a dropper, and heuristic scanners flag the shape
  rather than anything the program does. Leaving them beside the executable means nothing is written
  to disk at startup at all: managed assemblies are still inside the exe and load straight from
  memory. Moving them into a subfolder is not an option worth taking — the native loader looks next
  to the executable, and redirecting it costs a platform-specific hack in exchange for hiding two
  files.

  Compression, for the same reason: a compressed payload is high-entropy, which is another thing
  scanners weigh. Zip the folder for transport instead and the size comes back anyway.

  Keep the five together, and zip them before uploading anywhere — a bare .exe attracts scrutiny the
  same bytes inside an archive do not.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- The runtime travels with the application. -->
    <SelfContained>true</SelfContained>

    <!-- One bundle for the managed side, so the runtime is not 200 loose assemblies. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Precompiled, so the first frame does not wait on the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Deliberately off. Silk.NET resolves native entry points and SharpGLTF serialises through
         reflection; a trimmer has no way to see either, and what it removes only fails at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Symbols go inside the executable. Without the second line the referenced projects still
         drop their .pdb beside it. -->
    <DebugType>embedded</DebugType>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
