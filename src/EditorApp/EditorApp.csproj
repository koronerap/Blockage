<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: a console subsystem process opens a black window behind the editor every
         time it starts. The headless modes keep their output by borrowing the terminal that
         launched them — see NativeConsole. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EditorApp</RootNamespace>

    <!-- The product is Blockage; EditorApp stays as the namespace so the source does not churn. -->
    <AssemblyName>Blockage</AssemblyName>
    <Product>Blockage</Product>
    <AssemblyTitle>Blockage</AssemblyTitle>

    <!-- The one place the desktop's version is written; the welcome screen reads it back from the
         assembly. It goes up with each milestone of the plan, "-dev" while the next is under way.
         The phone's ApplicationDisplayVersion stays at what the phone has until it catches up. -->
    <Version>0.8.0</Version>

    <!-- Generated, not drawn by hand: the write-icon switch renders it from AppIcon.
         Committed so a build needs no extra step. -->
    <ApplicationIcon>..\..\assets\icon\Blockage.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The UI font travels with the build, so the editor looks the same on every machine instead
         of falling back to whatever the OS happens to provide. Inter, SIL Open Font License. -->
    <Content Include="..\..\assets\fonts\**" LinkBase="assets\fonts" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EditorApp.Core\EditorApp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

</Project>
