<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android head. Everything that decides what a level is - the voxel world, the meshers, the
    editing operations, the .vxlevel format - lives in EditorApp.Core and is shared with the
    desktop editor unchanged. This project only knows how to put that on a screen and how to read
    a finger.

    Named Mobile rather than Android on purpose: a namespace ending in .Android shadows the
    Android.* binding namespaces from inside itself, and every qualified reference then has to be
    written global::Android.Whatever.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>

    <!-- Android 8.0. Older than anything likely to run a voxel editor comfortably, and low enough
         that the floor is never the reason a device is out. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>

    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EditorApp.Mobile</RootNamespace>
    <AssemblyName>Blockage.Mobile</AssemblyName>

    <ApplicationId>com.blockage.editor</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>

    <!-- An .apk, not an .aab: this is sideloaded onto a phone for testing, not uploaded to Play. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The shader sources, compiled into this project rather than copied into it. The shading
      arithmetic was measured against exact byte values on the desktop; sharing the source is what
      keeps that measurement meaningful here. EsShaders retargets the GLSL dialect, nothing else.
    -->
    <Compile Include="..\EditorApp\Rendering\Shaders.cs" Link="Rendering\Shaders.cs" />

    <!--
      The rest of the desktop's rendering that has no graphics API in it at all: the camera and its
      ray maths, the frustum planes, how a light angle becomes a direction, how coarse the ground
      grid is, and the geometry every overlay is built from. Sharing these is what keeps a phone and
      a desktop agreeing about where a tap landed.
    -->
    <Compile Include="..\EditorApp\Rendering\FlyCamera.cs" Link="Rendering\Shared\FlyCamera.cs" />
    <Compile Include="..\EditorApp\Rendering\Frustum.cs" Link="Rendering\Shared\Frustum.cs" />
    <Compile Include="..\EditorApp\Rendering\GroundGrid.cs" Link="Rendering\Shared\GroundGrid.cs" />
    <Compile Include="..\EditorApp\Rendering\LineGeometry.cs" Link="Rendering\Shared\LineGeometry.cs" />
    <Compile Include="..\EditorApp\Rendering\EditorOverlays.cs" Link="Rendering\Shared\EditorOverlays.cs" />
    <Compile Include="..\EditorApp\Rendering\SceneLighting.cs" Link="Rendering\Shared\SceneLighting.cs" />

    <!--
      The two tool state machines. Neither touches a graphics API or an input library — they take a
      camera, a point on screen and a press, and they were already written that way. Sharing them is
      what stops a phone and a desktop disagreeing about what an extrude is.
    -->
    <Compile Include="..\EditorApp\ExtrudeInteraction.cs" Link="Tools\Shared\ExtrudeInteraction.cs" />
    <Compile Include="..\EditorApp\TransformInteraction.cs" Link="Tools\Shared\TransformInteraction.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EditorApp.Core\EditorApp.Core.csproj" />
  </ItemGroup>

</Project>
