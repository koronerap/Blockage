<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The host project, for the parts of it that are plain arithmetic: how a voxel size maps to a grid
    cell, where a light angle points. These need no GL context and nothing here may touch a type that
    wants one — the reference brings Silk.NET along, but native libraries only load when something
    actually asks for them.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\EditorApp\EditorApp.csproj" />
  </ItemGroup>

  <!--
    The Android head's shader translation. Compiled in rather than referenced: the mobile project
    targets net10.0-android and nothing here can reference it, but the translation itself is string
    work with no Android in it, and it is exactly the kind of thing that would otherwise only fail
    on a device.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\EditorApp.Mobile\Rendering\EsShaders.cs" Link="Mobile\EsShaders.cs" />
    <Compile Include="..\..\src\EditorApp.Mobile\Rendering\OrbitCamera.cs" Link="Mobile\OrbitCamera.cs" />
    <Compile Include="..\..\src\EditorApp.Mobile\Rendering\TouchGestureTracker.cs" Link="Mobile\TouchGestureTracker.cs" />
  </ItemGroup>

</Project>
